# Copy this to .env and set your OpenRouter key (free, no card needed for :free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the free chat model list (comma-separated)
# OPENROUTER_MODELS=openrouter/auto:free,meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free

# Optional: override the OpenRouter embedding model shortcuts shown in the UI
# OPENROUTER_EMBED_MODELS=nvidia/nemotron-3.5-embed-1b:free,nvidia/nemotron-3.5-embed-8b:free

# Optional: tuning for OpenRouter embedding models (local fastembed is the default)
# EMBED_BATCH_SIZE=32
# EMBED_MAX_RETRIES=3
# EMBED_TIMEOUT_SEC=120

# Optional: cap reasoning ("thinking") tokens so free reasoning models leave room
# for the actual answer (default 256; set 0 to stop sending the reasoning field)
# REASONING_MAX_TOKENS=256

# Optional: ONNX intra-op threads for the local embedding model (default 1).
# One thread keeps RSS ~265 MB on small free hosts; raise it on bigger machines.
# EMBED_THREADS=1

# Optional: chat model preselected in the UI (default: particle-ai/particle-1:free)
# OPENROUTER_DEFAULT_MODEL=particle-ai/particle-1:free
